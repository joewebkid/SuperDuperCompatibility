{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Super Duper compatibility game record",
  "type": "object",
  "required": ["schemaVersion", "bundleId", "title", "version", "overallStatus", "milestones", "updated"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "bundleId": { "type": "string", "minLength": 3 },
    "title": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "overallStatus": { "enum": ["unknown", "partial", "verified", "issues", "blocked"] },
    "milestones": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "enum": ["unknown", "partial", "verified", "issues", "blocked"] }
    },
    "recommendedProfile": { "type": "string" },
    "ipaRelease": {
      "type": "object",
      "required": ["url", "fileName", "sha256", "rightsHolder", "authorizationNote"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "fileName": { "type": "string", "pattern": "(?i)\\.ipa$" },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "rightsHolder": { "type": "string", "minLength": 1 },
        "authorizationNote": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "notes": { "type": "string" },
    "testedOn": { "type": "array" },
    "updated": { "type": "string", "format": "date" }
  },
  "additionalProperties": true
}
